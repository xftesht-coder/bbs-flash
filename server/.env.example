# Copy to server/.env on the server; never commit real values.
BBS_ORIGIN=https://bbsflash.neochoice.ru
BBS_PORT=8787
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BBS_ACCOUNT_SECRET=
# Absolute path outside the public directory; owned only by the service user.
BBS_ACCOUNT_DB=/var/lib/bbs-flash/accounts.sqlite
# Published, reviewed privacy notice on the same origin. Required to enable login.
BBS_PRIVACY_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
