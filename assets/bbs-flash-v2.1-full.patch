+/* -------------------------------------------------------------------------
+   RX CHECKSUM VERIFICATION
+   The previous build carried the comment "checksum ignored/not required to
+   proceed" and applied whatever arrived. A single corrupted byte on a 1200-baud
+   line therefore became your new settings, silently.
+
+   TODO: REQUIRES_VERIFICATION — the checksum span for RESPONSE frames is not
+   documented anywhere public. Outgoing frames sum bytes [1..n-2]. For incoming
+   frames both [0..n-2] and [1..n-2] are plausible. Rather than guess and hard
+   fail on real hardware, this computes both, logs what matched, and only
+   rejects the frame when strict mode is on. One "Read all" against your SZZ9
+   tells you which convention it uses — then leave strict mode on permanently.
+   ------------------------------------------------------------------------- */
+let strictChecksum = false;
+
+function verifyRxChecksum(block, frame){
+  const n = frame.length;
+  const got = frame[n-1];
+  const sumFrom0 = frame.slice(0, n-1).reduce((s,b)=>s+b,0) % 256;
+  const sumFrom1 = frame.slice(1, n-1).reduce((s,b)=>s+b,0) % 256;
+  const ok = (got === sumFrom0) || (got === sumFrom1);
+  const which = (got === sumFrom0) ? '[0..n-2]' : (got === sumFrom1) ? '[1..n-2]' : 'none';
+
+  if(ok){
+    logLine(`checksum OK on ${BLOCK_NAME[block]||'block'} read — 0x${got.toString(16).padStart(2,'0')} matches span ${which}`,'l-sys');
+    return true;
+  }
+
+  logLine(`CHECKSUM MISMATCH on ${BLOCK_NAME[block]||'block'} read — received 0x${got.toString(16).padStart(2,'0')}, computed 0x${sumFrom0.toString(16).padStart(2,'0')} ([0..n-2]) / 0x${sumFrom1.toString(16).padStart(2,'0')} ([1..n-2]).`,'l-err');
+  if(strictChecksum){
+    logLine('Strict mode: frame discarded, values NOT applied. Read again.','l-err');
+    toast('Corrupt frame rejected — read again','err');
+    clearPending();
+    return false;
+  }
+  logLine('Strict mode is off, so the frame was applied anyway. Do not write these values back until you have re-read cleanly.','l-err');
+  toast('Checksum mismatch — verify before writing','err');
+  return true;
+}
